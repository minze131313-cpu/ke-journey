/* KEJourney 设计系统（DESIGN.md 移植）
 * 色板唯一事实来源仍是 app/globals.css 的 :root；本文件为其小程序端映射。
 * 规则同 Web 版：面向用户处不用纯黑/纯白；颜色一律取自 token；
 * 一屏一个强调色（青绿）；圆角仅 8–24px；投影仅两层。 */

page {
  /* 色板 */
  --ink: #16343a;
  --muted: #61787c;
  --muted-2: #8a918e;
  --paper: #fff8ec;
  --card: #fffefa;
  --surface-warm: #f8f5ed;
  --bg-deep: #efece3;
  --teal: #07877e;
  --teal-dark: #075f5a;
  --teal-hover: #08776f;
  --teal-bright: #08a095;
  --teal-soft: #edf5f1;
  --teal-wash: #e7faf6;
  --gold: #f1a530;
  --gold-deep: #c39744;
  --meta: #9a742f;
  --danger: #e55748;
  --danger-soft: #f9ebe7;
  --blue: #3288d8;
  --coral: #f27655;
  --sky: #dff5f4;
  --border: #ddd8cc;
  --border-soft: #eadcc4;
  --accent-on: #fffefa;

  /* 圆角（仅 8–24px 之间） */
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --radius-pill: 999px;

  /* 投影（仅两层：默认 Flat 无投影） */
  --elev-raised: 0 12rpx 28rpx rgba(22, 52, 58, 0.12);

  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Noto Sans SC", "Microsoft YaHei", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.85;
}

/* ============ 排版（大字模式通过 .scale-2x/.scale-3x 覆盖字号） ============ */

.font-display {
  font-family: Georgia, "Songti SC", "Noto Serif SC", serif;
  line-height: 1.12;
}

.eyebrow {
  font-family: ui-monospace, Menlo, monospace;
  font-size: 12px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--meta);
}

.t-hero { font-family: Georgia, "Songti SC", "Noto Serif SC", serif; font-size: 38px; line-height: 1.12; letter-spacing: -0.02em; }
.t-title { font-family: Georgia, "Songti SC", "Noto Serif SC", serif; font-size: 28px; line-height: 1.2; }
.t-title-sm { font-family: Georgia, "Songti SC", "Noto Serif SC", serif; font-size: 20px; line-height: 1.25; }
.t-lead { font-size: 18px; line-height: 1.85; color: var(--muted); }
.t-body { font-size: 16px; line-height: 1.85; }
.t-meta { font-size: 13px; line-height: 1.6; color: var(--muted); }
.t-small { font-size: 12px; line-height: 1.6; color: var(--muted-2); }

.strong { font-weight: 600; color: var(--ink); }
.accent { color: var(--teal); }
.gold { color: var(--gold-deep); }
.muted { color: var(--muted); }

.scale-2x .t-hero { font-size: 42px; }
.scale-2x .t-title { font-size: 32px; }
.scale-2x .t-title-sm { font-size: 24px; }
.scale-2x .t-lead { font-size: 22px; }
.scale-2x .t-body { font-size: 20px; }
.scale-2x .t-meta { font-size: 16px; }
.scale-2x .t-small { font-size: 14px; }

.scale-3x .t-hero { font-size: 46px; }
.scale-3x .t-title { font-size: 36px; }
.scale-3x .t-title-sm { font-size: 28px; }
.scale-3x .t-lead { font-size: 26px; }
.scale-3x .t-body { font-size: 24px; }
.scale-3x .t-meta { font-size: 18px; }
.scale-3x .t-small { font-size: 16px; }

/* ============ 布局 ============ */

.page { min-height: 100vh; box-sizing: border-box; }
.container { padding-left: 32rpx; padding-right: 32rpx; box-sizing: border-box; }

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.row-wrap { display: flex; flex-wrap: wrap; align-items: center; }
.row-baseline { display: flex; align-items: baseline; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }

/* ============ 组件 ============ */

.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 40rpx 36rpx;
  box-sizing: border-box;
}

.danger-card {
  background: var(--danger-soft);
  border: 1px solid var(--danger);
  border-radius: var(--radius-md);
  padding: 32rpx 36rpx;
  box-sizing: border-box;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px 20px;
  border-radius: 12px;
  font-size: 16px;
  line-height: 1.5;
  box-sizing: border-box;
}
.btn-primary { background: var(--teal); color: var(--accent-on); }
.btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
.btn-hover { opacity: 0.85; }

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  color: var(--muted);
  font-size: 14px;
  line-height: 1.4;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.chip-active { background: var(--teal); border-color: var(--teal); color: var(--accent-on); }

.mini-chip {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-warm);
  border: 1px solid var(--border-soft);
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
  margin: 0 12rpx 12rpx 0;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--teal-soft);
}
.live-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--teal); margin-right: 12rpx; }
.live-dot.wait { background: var(--gold); }

.legend-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 12rpx; flex-shrink: 0; }
.legend-item { display: flex; align-items: center; margin-right: 32rpx; margin-bottom: 12rpx; }

/* ============ 列表点状条目（高亮/行动/警示） ============ */

.dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin: 14rpx 20rpx 0 0; flex-shrink: 0; }
.dot-gold { background: var(--gold); }
.dot-teal { background: var(--teal); }
.dot-danger { background: var(--danger); }
.dot-item { display: flex; align-items: flex-start; padding: 12rpx 0; }

/* ============ 清单勾选 ============ */

.check-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid var(--border-soft);
}
.check-item:last-child { border-bottom: none; }
.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10px;
  border: 1px solid var(--border);
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-on);
  font-size: 22px;
  flex-shrink: 0;
}
.check-box.on { background: var(--teal); border-color: var(--teal); }

/* ============ 统计格 ============ */

.stat-grid { display: flex; flex-wrap: wrap; margin: 32rpx -12rpx 0; }
.stat { width: 50%; box-sizing: border-box; padding: 0 12rpx 24rpx; }
.stat-inner { border-top: 2px solid var(--teal); padding-top: 16rpx; }
.stat-value { font-family: Georgia, "Songti SC", "Noto Serif SC", serif; font-size: 24px; color: var(--ink); }
.stat-label { font-size: 12px; color: var(--muted-2); margin-top: 4rpx; }

/* ============ 时间线（逐日节奏） ============ */

.tl-item { display: flex; padding: 20rpx 0; border-bottom: 1px solid var(--border-soft); }
.tl-item:last-child { border-bottom: none; }
.tl-time { width: 170rpx; flex-shrink: 0; color: var(--meta); font-size: 14px; font-weight: 600; padding-top: 2rpx; }
.tl-body { flex: 1; min-width: 0; }
.tl-title { font-size: 16px; font-weight: 600; color: var(--ink); line-height: 1.5; }
.tl-note { font-size: 14px; color: var(--muted); line-height: 1.6; margin-top: 2rpx; }

/* ============ 详情页区块 / 图集 / 来源 ============ */

.section-block { margin-top: 48rpx; }
.section-title { font-family: Georgia, "Songti SC", "Noto Serif SC", serif; font-size: 22px; line-height: 1.25; margin-bottom: 16rpx; }

.hero-img { width: 100%; height: 440rpx; display: block; }

.swiper { width: 100%; height: 440rpx; }
.swiper-image { width: 100%; height: 440rpx; }
.media-caption { padding: 16rpx 32rpx; border-bottom: 1px solid var(--border-soft); box-sizing: border-box; }
.media-counter { color: var(--muted-2); margin-left: 16rpx; }

.source-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--border-soft);
}
.source-item:last-child { border-bottom: none; }
.source-text { flex: 1; min-width: 0; }
.source-copy { color: var(--teal); font-size: 14px; flex-shrink: 0; margin-left: 24rpx; }

/* ============ 底部翻页 ============ */

.pager { display: flex; margin-top: 56rpx; }
.pager-btn { flex: 1; }
.pager-gap { width: 24rpx; }

/* ============ 拍照归档结果卡片 / 节点选择器（遮罩浮层） ============ */

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(22, 52, 58, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet-card {
  width: 100%;
  max-height: 82vh;
  background: var(--card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.sheet-img {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-md);
  display: block;
}

.sheet-body {
  padding-top: 24rpx;
}

.mini-chip-warn {
  background: var(--danger-soft);
  border-color: var(--danger);
  color: var(--danger);
}

.assign-btn {
  margin-top: 16rpx;
  padding: 8px 24px;
  font-size: 14px;
  align-self: flex-start;
}

.node-picker {
  display: flex;
  flex-direction: column;
}

.node-list {
  max-height: 60vh;
}

.node-item {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1px solid var(--border-soft);
}

.node-item-hover {
  background: var(--teal-soft);
}

