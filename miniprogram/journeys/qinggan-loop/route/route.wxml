<import src="/templates/detail.wxml" />

<view class="page {{scaleClass}}">
  <block wx:if="{{detail}}">
    <image class="hero-img" src="{{detail.hero.src}}" mode="aspectFill" binderror="onImgError" data-name="hero" data-src="{{detail.hero.src}}" />
    <view class="container">
      <view class="head-block">
        <text class="eyebrow">D{{day}} · 逐日线路 · {{cardTitle}}</text>
        <view class="t-title" style="margin-top: 12rpx;">{{detail.day.title}}</view>
        <view class="t-meta" style="margin-top: 8rpx;">
          {{detail.day.start}} → {{detail.day.end}} · 住 {{detail.day.stay}} · {{detail.day.km}} · {{detail.day.drive}}
        </view>
      </view>

      <view class="t-lead" style="margin-top: 24rpx;">{{detail.lead}}</view>

      <view class="stat-grid">
        <view class="stat" wx:for="{{stats}}" wx:key="label">
          <view class="stat-inner">
            <view class="stat-value">{{item.value}}</view>
            <view class="stat-label">{{item.label}}</view>
          </view>
        </view>
      </view>

      <template is="sections" data="{{sections: sections}}" />

      <view class="section-block">
        <view class="section-title font-display">当天节奏</view>
        <view class="tl-item" wx:for="{{rhythm}}" wx:key="time">
          <view class="tl-time">{{item.time}}</view>
          <view class="tl-body">
            <view class="tl-title">{{item.title}}</view>
            <view class="tl-note">{{item.note}}</view>
          </view>
        </view>
      </view>

      <view class="section-block">
        <view class="section-title font-display">当日路线 · 地图参考</view>
        <view class="day-map-wrap">
          <map
            id="day-map"
            class="day-map"
            longitude="{{detail.day.route[0][0]}}"
            latitude="{{detail.day.route[0][1]}}"
            scale="9"
            markers="{{dayMarkers}}"
            polyline="{{dayPolylines}}"
            bindupdated="onDayMapUpdated"
            show-location="{{false}}"
            enable-zoom
            enable-scroll
            enable-rotate="{{false}}"
          />
        </view>
        <view class="t-small" style="margin-top: 12rpx;">
          红色虚线为封闭施工路段 · <text class="accent" bindtap="openFullMap">查看全程地图 →</text>
        </view>
      </view>

      <template is="cautions" data="{{cautions: cautions}}" />

      <view class="section-block">
        <view class="section-title font-display">沿线实景</view>
      </view>
      <template is="gallery" data="{{galleryItems: galleryItems, galleryIndex: galleryIndex}}" />

      <template is="sources" data="{{sources: sources}}" />

      <view class="pager">
        <view
          wx:if="{{prev}}"
          class="btn btn-ghost pager-btn"
          hover-class="btn-hover"
          bindtap="goDay"
          data-day="{{prev}}"
        >← D{{prev}}</view>
        <view wx:else class="btn btn-ghost pager-btn dim">首日</view>
        <view class="pager-gap" />
        <view
          wx:if="{{next}}"
          class="btn btn-primary pager-btn"
          hover-class="btn-hover"
          bindtap="goDay"
          data-day="{{next}}"
        >D{{next}} →</view>
        <view wx:else class="btn btn-primary pager-btn dim">完成</view>
      </view>
      <view style="height: 64rpx;" />
    </view>
  </block>
  <view wx:else class="container">
    <view class="t-body" style="padding: 80rpx 0;">这一天还没有内容。</view>
  </view>
</view>
