<view class="page trip-home {{scaleClass}}">
  <!-- 头部 -->
  <view class="trip-header container">
    <view class="row-between">
      <view class="flex-1">
        <text class="eyebrow">{{config.kicker}}</text>
        <view class="t-title">{{card.title}}</view>
        <view class="t-meta">{{config.loopSummary}} · {{config.directionLabel}}</view>
      </view>
      <view class="header-actions">
        <view class="btn btn-ghost cam-btn" hover-class="btn-hover" bindtap="onTakePhoto">拍照</view>
        <text class="fav-star {{favorite ? 'fav-on' : ''}}" bindtap="toggleFavorite">{{favorite ? "★" : "☆"}}</text>
        <button class="share-btn" open-type="share" size="mini">分享</button>
      </view>
    </view>
    <view class="status-pill" style="margin-top: 12rpx;">
      <view class="live-dot {{mapReady ? '' : 'wait'}}" />
      <text class="t-small">{{mapStatus}}</text>
    </view>
  </view>

  <!-- 区块快跳（吸顶：上滑时始终露出） -->
  <view class="anchor-nav container">
    <view class="chip {{anchor === 'sec-trip' || anchor === '' ? 'chip-active' : ''}}" hover-class="btn-hover" bindtap="jumpTo" data-anchor="sec-trip">行程</view>
    <view class="chip {{anchor === 'sec-map' ? 'chip-active' : ''}}" hover-class="btn-hover" bindtap="jumpTo" data-anchor="sec-map">地图</view>
    <view class="chip {{anchor === 'sec-roads' ? 'chip-active' : ''}}" hover-class="btn-hover" bindtap="jumpTo" data-anchor="sec-roads">路况</view>
    <view class="chip {{anchor === 'sec-checklist' ? 'chip-active' : ''}}" hover-class="btn-hover" bindtap="jumpTo" data-anchor="sec-checklist">清单</view>
  </view>

    <!-- 行程列表（核心） -->
    <view id="sec-trip" class="container">
      <view class="section-title font-display">12 天行程</view>
      <view class="t-lead" style="margin-bottom: 8rpx;">{{config.loopSummary}} · 点击任一天查看当天详情</view>
      <view
        class="card day-card"
        wx:for="{{tripDays}}"
        wx:key="day"
        bindtap="openRoute"
        data-day="{{item.day}}"
        hover-class="day-card-hover"
      >
        <view class="row-baseline">
          <text class="t-title-sm font-display">D{{item.day}}</text>
          <text class="t-meta">{{item.drive}} · {{item.km}}</text>
        </view>
        <view class="t-body strong" style="margin-top: 8rpx;">{{item.title}}</view>
        <view class="t-meta" style="margin-top: 4rpx;">{{item.start}} → {{item.end}} · 住 {{item.stay}}</view>
        <view class="t-body" style="margin-top: 8rpx;">{{item.summary}}</view>
        <view class="row-wrap" style="margin-top: 16rpx;">
          <view
            class="stop-chip"
            wx:for="{{item.stops}}"
            wx:for-item="stop"
            wx:key="id"
            catchtap="openStop"
            data-id="{{stop.id}}"
            hover-class="btn-hover"
          >
            <view class="legend-dot" style="background: {{stop.color}};" />
            <text class="t-small">{{stop.name}}</text>
          </view>
        </view>
        <view class="t-small accent" style="margin-top: 16rpx;">查看当天详情 →</view>
      </view>
    </view>

    <!-- 地图（辅助参考） -->
    <view id="sec-map" class="container">
      <view class="section-title font-display" style="margin-top: 48rpx;">路线地图 · 参考</view>
      <view class="t-small" style="margin-bottom: 12rpx;">红色虚线为封闭施工路段；点击节点查看档案</view>
      <view class="filter-row">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="chip {{category === item.key ? 'chip-active' : ''}}"
          hover-class="btn-hover"
          bindtap="tapCategory"
          data-key="{{item.key}}"
        >{{item.label}}</view>
      </view>
      <view class="map-wrap">
        <map
          id="trip-map"
          class="trip-map"
          longitude="{{config.mapCenter[0]}}"
          latitude="{{config.mapCenter[1]}}"
          scale="{{mapScale}}"
          markers="{{markers}}"
          polyline="{{polylines}}"
          bindmarkertap="onMarkerTap"
          bindupdated="onMapUpdated"
          show-location="{{false}}"
          enable-zoom
          enable-scroll
          enable-rotate="{{false}}"
        />
      </view>
      <scroll-view class="day-strip" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="day-strip-inner">
          <view
            wx:for="{{dayOptions}}"
            wx:key="day"
            class="day-chip {{day === item.day ? 'day-chip-active' : ''}}"
            hover-class="btn-hover"
            bindtap="tapDay"
            data-day="{{item.day}}"
          >{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="card place-card" wx:if="{{selectedPlace}}" style="margin-top: 24rpx;">
        <view class="row-baseline">
          <text class="eyebrow">{{selectedPlace.catLabel}} · D{{selectedPlace.place.day}}</text>
          <view class="legend-dot" style="background: {{selectedPlace.catColor}}; margin-right: 0;" />
        </view>
        <view class="t-title-sm" style="margin-top: 8rpx;">{{selectedPlace.place.name}}</view>
        <view class="t-meta">{{selectedPlace.place.region}} · {{selectedPlace.place.subtitle}}</view>
        <view class="t-body" style="margin-top: 12rpx;">{{selectedPlace.place.description}}</view>
        <view class="row" style="margin-top: 24rpx;">
          <view class="btn btn-primary flex-1" hover-class="btn-hover" bindtap="openDetail">查看详情</view>
          <view class="btn btn-ghost flex-1" style="margin-left: 20rpx;" hover-class="btn-hover" bindtap="openNavigate">导航</view>
        </view>
      </view>
      <view class="legend row-wrap" style="margin-top: 24rpx;">
        <view class="legend-item" wx:for="{{legend}}" wx:key="key">
          <view class="legend-dot" style="background: {{item.color}};" />
          <text class="t-small">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 路况 -->
    <view id="sec-roads" class="container">
      <view class="section-title font-display" style="margin-top: 48rpx;">路况与绕行</view>
      <view class="danger-card" wx:if="{{roads.alert}}" style="margin-top: 8rpx;">
        <text class="eyebrow">{{roads.alert.badge}}</text>
        <view class="t-title-sm" style="margin-top: 8rpx;">{{roads.alert.title}}</view>
        <view class="t-body" style="margin-top: 8rpx;">{{roads.alert.description}}</view>
        <view class="t-body" style="margin-top: 16rpx;">
          <text class="strong">{{roads.alert.detourLabel}}：</text>{{roads.alert.detour}}
        </view>
        <view class="row-between" style="margin-top: 20rpx;">
          <text class="t-small">{{roads.kicker}} · {{roads.lastCheck}}</text>
          <view class="btn btn-ghost road-focus-btn" hover-class="btn-hover" bindtap="focusAlertDay">地图定位</view>
        </view>
      </view>
      <view class="card" wx:for="{{roads.notes}}" wx:key="title" style="margin-top: 24rpx;">
        <view class="t-title-sm">{{item.title}}</view>
        <view class="t-body" style="margin-top: 8rpx;">{{item.text}}</view>
      </view>
    </view>

    <!-- 清单 -->
    <view id="sec-checklist" class="container">
      <view class="section-title font-display" style="margin-top: 48rpx;">出发清单</view>
      <view class="t-lead" style="margin-bottom: 8rpx;">勾选状态保存在本机，出发前逐项核对</view>
      <view
        class="card"
        wx:for="{{checklistGroups}}"
        wx:for-index="gi"
        wx:for-item="group"
        wx:key="title"
        style="margin-bottom: 24rpx;"
      >
        <view class="t-title-sm">{{group.title}}</view>
        <view
          class="check-item"
          wx:for="{{group.items}}"
          wx:for-index="ii"
          wx:for-item="entry"
          wx:key="key"
          bindtap="toggleCheck"
          data-gi="{{gi}}"
          data-ii="{{ii}}"
          data-key="{{entry.key}}"
        >
          <view class="check-box {{entry.done ? 'on' : ''}}">{{entry.done ? "✓" : ""}}</view>
          <text class="t-body flex-1">{{entry.text}}</text>
        </view>
      </view>
      <view class="danger-card" style="margin-bottom: 32rpx;">
        <text class="eyebrow">{{emergency.label}}</text>
        <view class="t-body strong" style="margin-top: 8rpx;">{{emergency.numbers}}</view>
        <view class="t-meta" style="margin-top: 4rpx;">{{emergency.note}}</view>
      </view>
    </view>

    <!-- 实拍足迹 -->
    <view id="sec-photos" class="container">
      <view class="section-title font-display" style="margin-top: 48rpx;">实拍足迹</view>
      <view class="t-lead" style="margin-bottom: 8rpx;">点「拍照」自动匹配节点并生成一句话笔记 · 长按可删除</view>
      <view class="card" wx:if="{{userPhotos.length === 0}}">
        <view class="t-body">还没有实拍。点击右上角「拍照」，照片会按拍摄位置自动归档到对应节点。</view>
      </view>
      <view
        class="card photo-card"
        wx:for="{{userPhotos}}"
        wx:key="_id"
        bindtap="onPhotoTap"
        data-poi-id="{{item.poiId}}"
        bindlongpress="deletePhoto"
        data-id="{{item._id}}"
        data-fileid="{{item.fileID}}"
      >
        <image class="photo-thumb" src="{{item.fileID}}" mode="aspectFill" binderror="onImgError" data-name="photo-{{index}}" data-src="{{item.fileID}}" />
        <view class="photo-body flex-1">
          <view class="row-wrap">
            <text class="mini-chip">{{item.categoryLabel}}</text>
            <text class="mini-chip" wx:if="{{item.distanceKm !== null}}">约 {{item.distanceKm}} km</text>
          </view>
          <view class="t-body strong">{{item.caption}}</view>
          <view class="t-meta">{{item.placeName}} · {{item.timeText}}</view>
        </view>
      </view>
    </view>

    <view class="t-small" style="padding: 8rpx 0 64rpx; text-align: center;">内容与 Web 版同步 · 路况与票务出发前请再次核验</view>
</view>
