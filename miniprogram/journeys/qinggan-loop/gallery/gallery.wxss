.gallery-header {
  padding-top: 24rpx;
  padding-bottom: 8rpx;
}

.clear-btn {
  padding: 8px 20px;
  font-size: 14px;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.filter-panel {
  padding-top: 16rpx;
}

.filter-label {
  margin: 16rpx 0 8rpx;
}

.date-header {
  font-size: 26px;
  margin: 32rpx 0 12rpx;
}

.photo-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.photo-img {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-md);
  display: block;
}

.photo-info {
  padding-top: 20rpx;
}

.phase-chip {
  background: var(--teal-soft);
  border-color: var(--teal);
  color: var(--teal-dark);
}

.monologue {
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.gallery-cta {
  margin-top: 24rpx;
}
