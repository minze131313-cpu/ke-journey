{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "optimize:images": "node scripts/optimize-images.mjs",
    "sync:travel-story": "node scripts/sync-travel-story-seed.mjs",
    "export:mini": "node scripts/gen-marker-icons.mjs && node scripts/export-mini-data.mjs",
    "test:mini": "node scripts/export-mini-data.mjs && node --test tests/mini-data.test.mjs",
    "e2e:mini": "node tests/mini-e2e.mjs",
    "mp:open": "node scripts/devtools-cli.mjs open",
    "mp:preview": "node scripts/devtools-cli.mjs preview --qr-format terminal",
    "mp:upload": "node scripts/devtools-cli.mjs upload",
    "mp:build-npm": "node scripts/devtools-cli.mjs build-npm",
    "mp:islogin": "node scripts/devtools-cli.mjs islogin",
    "mp:login": "node scripts/devtools-cli.mjs login",
    "mp:close": "node scripts/devtools-cli.mjs close"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "ws": "^8.21.3"
  },
  "type": "module"
}
